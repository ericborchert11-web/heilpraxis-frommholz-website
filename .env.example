# Lokal für `next dev`: in .env.local kopieren und Werte eintragen.
# Auf Vercel: unter Project Settings → Environment Variables anlegen.
# .env.local ist via .gitignore vom Tracking ausgeschlossen.

# Primäre Site-URL — wird in metadataBase, allen Canonicals, der Sitemap,
# robots.txt und im JSON-LD (@id, url, image) verwendet. Default ist Apex.
# Wenn auf www umgestellt werden soll: Wert auf https://www.heilpraxis-frommholz.de
# setzen und Project re-deployen (Canonicals sind statisch gebaut).
NEXT_PUBLIC_SITE_URL=

# Resend API-Key — aus dem Resend-Dashboard (https://resend.com/api-keys)
RESEND_API_KEY=

# Versender-Adresse für Kontaktformular-Mails.
# Domain muss in Resend verifiziert sein. Solange das nicht passiert ist,
# funktioniert der Fallback "onboarding@resend.dev" (sieht aber unprofessionell aus).
# Beispiel nach Domain-Verifizierung:
#   MAIL_FROM=Heilpraxis Frommholz <kontakt@heilpraxis-frommholz.de>
MAIL_FROM=

# Empfänger der Kontaktformular-Anfragen. Default = BUSINESS.email aus site-config.
# MAIL_TO=simeon@heilpraxis-frommholz.de
MAIL_TO=
